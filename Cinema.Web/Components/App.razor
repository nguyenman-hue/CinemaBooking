<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Starlight Cinema Huế - Đặt Vé &amp; Chọn Ghế Xem Phim Trực Tuyến</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css?v=darkneon_v6" />
    <link rel="stylesheet" href="Cinema.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script>
        // Sử dụng sessionStorage để mỗi tab trình duyệt là một khách hàng riêng biệt (độc lập ghế và giỏ hàng)
        // Khi F5 lại trang, sessionStorage vẫn lưu giữ ghế và bộ đếm 10 phút của tab đó!
        window.getCinemaSessionId = function () {
            try {
                var tabId = sessionStorage.getItem('Cinema_TabSessionId');
                if (tabId && tabId.length > 5) {
                    return tabId;
                }
                var newId = 'session_' + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
                sessionStorage.setItem('Cinema_TabSessionId', newId);
                return newId;
            } catch (e) {
                return 'session_' + Date.now().toString(36);
            }
        };

        window.cinemaAuthLogin = async function (username, password, returnUrl) {
            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ username: username, password: password, returnUrl: returnUrl })
                });
                return await response.json();
            } catch (e) {
                return { success: false, message: e.message || 'Lỗi kết nối máy chủ.' };
            }
        };

        window.clearCinemaSession = function () {
            try {
                sessionStorage.removeItem('Cinema_TabSessionId');
                localStorage.removeItem('Cinema_UserSessionId');
                document.cookie = "Cinema_UserSessionId=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            } catch (e) {}
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
