@using Cinema.CoreBusiness.Rules
@using Cinema.UseCases.PluginInterfaces.StateStore
@implements IDisposable
@inject IGetSeatMapUseCase GetSeatMapUseCase
@inject IHoldSeatsUseCase HoldSeatsUseCase
@inject ISeatHoldingStateStore HoldingStore
@inject UserSessionService UserSession
@inject IJSRuntime JS

<div class="seat-map-wrapper">
    <!-- Countdown Timer Banner (When seats are selected) -->
    @if (_selectedSeatIds.Count > 0 && _remainingSeconds > 0)
    {
        <div class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-4 rounded-4 shadow-sm"
             style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.14), rgba(239, 68, 68, 0.08)); border: 1px solid rgba(245, 158, 11, 0.4); backdrop-filter: blur(10px);">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5); color: #fbbf24;">
                    <i class="bi bi-stopwatch-fill fs-4"></i>
                </div>
                <div>
                    <div class="fw-bold text-white d-flex align-items-center gap-2">
                        <span>Thời gian giữ ghế còn lại:</span>
                        <span class="badge bg-danger fs-6 font-monospace px-3 py-1 shadow-sm" style="letter-spacing: 1px; box-shadow: 0 0 10px rgba(239, 68, 68, 0.5) !important;">
                            @_countdownText
                        </span>
                    </div>
                    <div class="small mt-1" style="color: #cbd5e1;">
                        Vui lòng hoàn tất thông tin &amp; đặt vé trước khi hết 10 phút. Hệ thống tự động bảo lưu ghế của bạn kể cả khi tải lại trang!
                    </div>
                </div>
            </div>
            <button type="button" 
                    class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 mt-2 mt-sm-0 rounded-pill d-flex align-items-center gap-1 shadow-sm" 
                    @onclick="HandleReleaseAllSeats"
                    style="border-color: rgba(239, 68, 68, 0.6); color: #fca5a5;">
                <i class="bi bi-x-circle-fill"></i>
                <span>Hủy Giữ Ghế</span>
            </button>
        </div>
    }

        @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger alert-dismissible fade show p-3 mb-3 small d-flex align-items-center justify-content-between shadow-sm" 
             role="alert" 
             style="border-radius: 12px; background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.45); color: #fee2e2;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <span class="fw-semibold">@_loadError</span>
            </div>
            <button type="button" class="btn-close" @onclick="() => SetError(null)"></button>
        </div>
    }

    <!-- Cinema Screen View -->
    <div class="screen-container">
        <div class="screen-bar"></div>
        <div class="screen-beam"></div>
        <div class="screen-text">
            <i class="bi bi-display me-1"></i>MÀN HÌNH CHIẾU
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Đang tải sơ đồ ghế...</span>
            </div>
            <p class="text-muted mt-2">Đang tải sơ đồ phòng chiếu...</p>
        </div>
    }
    else
    {
        <!-- Seat Grid by Rows -->
        <div class="d-flex flex-column align-items-center mb-4">
            @foreach (var rowGroup in _seats.GroupBy(s => s.RowCode).OrderBy(g => g.Key))
            {
                <div class="seat-row">
                    <div class="row-label">@rowGroup.Key</div>

                    @foreach (var seat in rowGroup.OrderBy(s => s.SeatNumber))
                    {
                        var isSelected = _selectedSeatIds.Contains(seat.SeatId);
                        var seatClass = GetSeatCssClass(seat, isSelected);
                        var tooltip = GetSeatTooltip(seat, isSelected);

                        <button type="button"
                                class="seat-item @seatClass"
                                title="@tooltip"
                                disabled="@(IsDisabled)"
                                @onclick="() => ToggleSeatSelection(seat)">
                            @seat.SeatNumber
                        </button>
                    }

                    <div class="row-label">@rowGroup.Key</div>
                </div>
            }
        </div>

        <!-- Chú thích sơ đồ ghế khớp chuẩn hệ thống -->
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 gap-md-4 py-3 my-2" style="max-width: 750px; margin: 0 auto;">
            <!-- Ghế Thường -->
            <div class="d-flex align-items-center gap-2">
                <span class="seat-mini-box seat-mini-standard" 
                      style="width: 24px; height: 18px; border-radius: 4px; display: inline-block; background-color: #1e293b; border: 1.5px solid #475569;"></span>
                <span class="text-white fw-medium" style="font-size: 0.95rem;">Ghế Thường</span>
            </div>

            <!-- Ghế VIP -->
            <div class="d-flex align-items-center gap-2">
                <span class="seat-mini-box seat-mini-vip" 
                      style="width: 24px; height: 18px; border-radius: 4px; display: inline-block; background-color: #2a1708; border: 1.5px solid #f59e0b; box-shadow: 0 0 6px rgba(245, 158, 11, 0.35);"></span>
                <span class="text-white fw-medium" style="font-size: 0.95rem;">Ghế VIP</span>
            </div>

            <!-- Ghế Sweetbox -->
            <div class="d-flex align-items-center gap-2">
                <span class="seat-mini-box seat-mini-sweetbox" 
                      style="width: 24px; height: 18px; border-radius: 4px; display: inline-block; background-color: #3b0720; border: 1.5px solid #ec4899; box-shadow: 0 0 6px rgba(236, 72, 153, 0.35);"></span>
                <span class="text-white fw-medium" style="font-size: 0.95rem;">Ghế Sweetbox</span>
            </div>

            <!-- Ghế chọn -->
            <div class="d-flex align-items-center gap-2">
                <span class="seat-mini-box seat-mini-selected" 
                      style="width: 24px; height: 18px; border-radius: 4px; display: inline-block; background-color: #facc15; border: 1.5px solid #eab308; box-shadow: 0 0 8px rgba(250, 204, 21, 0.7);"></span>
                <span class="text-white fw-medium" style="font-size: 0.95rem;">Ghế chọn</span>
            </div>

            <!-- Ghế đã bán -->
            <div class="d-flex align-items-center gap-2">
                <span class="seat-mini-box seat-mini-sold" 
                      style="width: 24px; height: 18px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; background-color: rgba(30, 41, 59, 0.55); border: 1.5px solid rgba(71, 85, 105, 0.5); position: relative; overflow: hidden;">
                    <span style="width: 100%; height: 2px; background-color: #94a3b8; display: block;"></span>
                </span>
                <span class="text-white fw-medium" style="font-size: 0.95rem;">Ghế đã bán</span>
            </div>
        </div>
        <!-- Real-time selected seats summary -->
        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" 
             style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(51, 65, 85, 0.5);">
            <div>
                <span class="small" style="color: #94a3b8;">Ghế đã chọn: </span>
                @if (_selectedSeatIds.Count == 0)
                {
                    <span class="fw-bold" style="color: #64748b;">Chưa chọn ghế nào</span>
                }
                else
                {
                    <span class="fw-bold text-success">
                        @string.Join(", ", _seats.Where(s => _selectedSeatIds.Contains(s.SeatId)).Select(s => s.SeatDisplayName))
                    </span>
                    <span class="badge bg-success ms-2 fw-bold">@_selectedSeatIds.Count ghế</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm text-light" @onclick="() => LoadSeatsAsync(false)" title="Làm mới tình trạng ghế">
                    <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ShowtimeId { get; set; }
    [Parameter] public decimal BasePrice { get; set; }
    [Parameter] public EventCallback<List<SeatDto>> OnSelectionChanged { get; set; }
    [Parameter] public bool IsDisabled { get; set; } = false;

    private List<SeatDto> _seats = new();
    private HashSet<int> _selectedSeatIds = new();
    private bool _isLoading = true;
        private string? _loadError;
    private CancellationTokenSource? _errorCts;
    private int _lastLoadedShowtimeId;

    // Countdown timer state
    private System.Threading.Timer? _countdownTimer;
    private int _remainingSeconds = 0;
    private string _countdownText = "10:00";
    private DateTime? _holdExpiryUtc;

    protected override void OnInitialized()
    {
        HoldingStore.OnSeatsChanged += HandleExternalSeatsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastLoadedShowtimeId != ShowtimeId)
        {
            _lastLoadedShowtimeId = ShowtimeId;
            _selectedSeatIds.Clear();
            StopTimer();
            await LoadSeatsAsync(notifyParent: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientSessionId = await JS.InvokeAsync<string>("getCinemaSessionId");
                if (!string.IsNullOrWhiteSpace(clientSessionId))
                {
                    if (clientSessionId != UserSession.SessionId)
                    {
                        UserSession.SetSessionId(clientSessionId);
                    }
                    await LoadSeatsAsync(notifyParent: true);
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async void HandleExternalSeatsChanged(int showtimeId)
    {
        if (showtimeId == 0 || showtimeId == ShowtimeId)
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadSeatsAsync(notifyParent: false);
                    StateHasChanged();
                });
            }
            catch { }
        }
    }

    public async Task LoadSeatsAsync(bool notifyParent = false)
    {
        // Chỉ hiện spinner tải toàn màn hình ở lần đầu tiên khi chưa có danh sách ghế
        if (_seats.Count == 0)
        {
            _isLoading = true;
        }
        _loadError = null;
        try
        {
            HoldingStore.CleanExpiredHolds();
            var result = await GetSeatMapUseCase.ExecuteAsync(ShowtimeId, UserSession.SessionId);
            _seats = result.ToList();

            // Khôi phục các ghế phiên hiện tại đang giữ nếu vừa F5 hoặc tải lại trang
            if (_selectedSeatIds.Count == 0)
            {
                var myHeld = _seats.Where(s => s.IsHeldByMe).Select(s => s.SeatId).ToList();
                if (myHeld.Any())
                {
                    foreach (var id in myHeld)
                    {
                        _selectedSeatIds.Add(id);
                    }

                    var expiry = HoldingStore.GetHoldExpiryTime(ShowtimeId, UserSession.SessionId);
                    if (expiry.HasValue && expiry.Value > DateTime.UtcNow)
                    {
                        _holdExpiryUtc = expiry.Value;
                        StartTimer();
                    }
                    notifyParent = true;
                }
            }

            // Loại bỏ các ghế đã bị người khác đặt hoặc giữ khỏi danh sách đang chọn
            _selectedSeatIds.RemoveWhere(id => 
            {
                var s = _seats.FirstOrDefault(x => x.SeatId == id);
                return s == null || s.IsBooked || (s.IsHeldByOther && !s.IsHeldByMe);
            });

            if (_selectedSeatIds.Count == 0)
            {
                StopTimer();
            }

            if (notifyParent)
            {
                await NotifyParentSelectionAsync();
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Không thể tải sơ đồ ghế: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    
    private void SetError(string? message, int autoDismissSeconds = 4)
    {
        _errorCts?.Cancel();
        _errorCts?.Dispose();
        _errorCts = null;

        _loadError = message;
        StateHasChanged();

        if (!string.IsNullOrEmpty(message) && autoDismissSeconds > 0)
        {
            _errorCts = new CancellationTokenSource();
            var token = _errorCts.Token;

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(autoDismissSeconds * 1000, token);
                    if (!token.IsCancellationRequested)
                    {
                        await InvokeAsync(() =>
                        {
                            _loadError = null;
                            StateHasChanged();
                        });
                    }
                }
                catch (TaskCanceledException) { }
            }, token);
        }
    }

    private async Task ToggleSeatSelection(SeatDto seat)
    {
        if (IsDisabled) return;

        if (seat.IsBooked)
        {
            SetError($"Ghế {seat.SeatDisplayName} đã được bán vé thành công. Vui lòng chọn ghế còn trống khác!");
            return;
        }

        if (seat.IsHeldByOther && !seat.IsHeldByMe)
        {
            SetError($"Ghế {seat.SeatDisplayName} hiện đang được khách hàng khác giữ chỗ (tối đa 10 phút). Vui lòng chọn ghế khác hoặc chờ hết thời gian giữ chỗ!");
            return;
        }

        _loadError = null;

        if (_selectedSeatIds.Contains(seat.SeatId))
        {
            var candidateSeatIds = _selectedSeatIds.Where(id => id != seat.SeatId).ToList();
            if (candidateSeatIds.Count > 0)
            {
                var domainSeats = _seats.Select(s => new Seat
                {
                    SeatId = s.SeatId,
                    AuditoriumId = s.AuditoriumId,
                    RowCode = s.RowCode,
                    SeatNumber = s.SeatNumber,
                    SeatType = s.SeatType,
                    PriceModifier = s.PriceModifier
                });
                var unavailable = _seats
                    .Where(s => s.IsBooked || (s.IsHeldByOther && !s.IsHeldByMe))
                    .Select(s => s.SeatId);

                try
                {
                    SeatBookingRule.ValidateNoSingleOrphanSeat(domainSeats, candidateSeatIds, unavailable);
                }
                catch (SeatConflictException ex)
                {
                    SetError(ex.Message);
                    return;
                }
            }

            _selectedSeatIds.Remove(seat.SeatId);
            HoldSeatsUseCase.Release(ShowtimeId, new[] { seat.SeatId }, UserSession.SessionId);

            if (_selectedSeatIds.Count == 0)
            {
                StopTimer();
            }
        }
        else
        {
            if (_selectedSeatIds.Count >= 8)
            {
                SetError("Bạn chỉ được chọn tối đa 8 ghế trong một lần đặt vé!");
                return;
            }

            // Kiểm tra LUẬT 1: Chống để trống 1 ghế đơn lẻ ở bên trái, giữa hoặc bên phải
            var candidateSeatIds = _selectedSeatIds.Concat(new[] { seat.SeatId }).ToList();
            var domainSeats = _seats.Select(s => new Seat
            {
                SeatId = s.SeatId,
                AuditoriumId = s.AuditoriumId,
                RowCode = s.RowCode,
                SeatNumber = s.SeatNumber,
                SeatType = s.SeatType,
                PriceModifier = s.PriceModifier
            });
            var unavailable = _seats
                .Where(s => s.IsBooked || (s.IsHeldByOther && !s.IsHeldByMe))
                .Select(s => s.SeatId);

            try
            {
                SeatBookingRule.ValidateNoSingleOrphanSeat(domainSeats, candidateSeatIds, unavailable);
            }
            catch (SeatConflictException ex)
            {
                SetError(ex.Message);
                return;
            }

            bool holdSuccess = HoldSeatsUseCase.TryHold(ShowtimeId, new[] { seat.SeatId }, UserSession.SessionId, TimeSpan.FromMinutes(10));
            if (!holdSuccess)
            {
                SetError($"Ghế {seat.SeatDisplayName} vừa bị người khác chọn trước. Vui lòng chọn ghế khác!");
                await LoadSeatsAsync(notifyParent: true);
                return;
            }

            _selectedSeatIds.Add(seat.SeatId);

            if (_countdownTimer == null)
            {
                _holdExpiryUtc = DateTime.UtcNow.AddMinutes(10);
                StartTimer();
            }
        }

        await NotifyParentSelectionAsync();
    }

    private void StartTimer()
    {
        StopTimer();
        _remainingSeconds = 600;
        _countdownText = "10:00";

        _countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (_holdExpiryUtc.HasValue)
            {
                var remaining = (int)Math.Max(0, (_holdExpiryUtc.Value - DateTime.UtcNow).TotalSeconds);
                _remainingSeconds = remaining;
                var ts = TimeSpan.FromSeconds(remaining);
                _countdownText = $"{remaining / 60:D2}:{remaining % 60:D2}";

                if (remaining <= 0)
                {
                    StopTimer();
                    await InvokeAsync(async () =>
                    {
                        if (_selectedSeatIds.Count > 0)
                        {
                            HoldSeatsUseCase.Release(ShowtimeId, _selectedSeatIds, UserSession.SessionId);
                            _selectedSeatIds.Clear();
                            SetError("Thời gian giữ ghế (10 phút) đã hết. Ghế đã được tự động giải phóng!");
                            await NotifyParentSelectionAsync();
                            await LoadSeatsAsync(notifyParent: true);
                            StateHasChanged();
                        }
                    });
                }
                else
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
        _remainingSeconds = 0;
        _countdownText = "10:00";
    }

    public async Task HandleReleaseAllSeats()
    {
        if (_selectedSeatIds.Count > 0)
        {
            HoldSeatsUseCase.Release(ShowtimeId, _selectedSeatIds, UserSession.SessionId);
            _selectedSeatIds.Clear();
            StopTimer();
            await NotifyParentSelectionAsync();
            await LoadSeatsAsync(notifyParent: true);
        }
    }

    private async Task NotifyParentSelectionAsync()
    {
        var selectedList = _seats.Where(s => _selectedSeatIds.Contains(s.SeatId)).ToList();
        await OnSelectionChanged.InvokeAsync(selectedList);
    }

    private string GetSeatCssClass(SeatDto seat, bool isSelected)
    {
        if (seat.IsBooked)
            return "seat-sold";

        if (isSelected || seat.IsHeldByMe)
            return "seat-selected";

        if (seat.IsHeldByOther)
            return "seat-held";

        return seat.SeatType switch
        {
            "VIP" => "seat-vip",
            "Sweetbox" => "seat-sweetbox",
            _ => "seat-standard"
        };
    }

    private string GetSeatTooltip(SeatDto seat, bool isSelected)
    {
        if (seat.IsBooked) 
            return $"Ghế {seat.SeatDisplayName} - Đã bán";
        if (isSelected || seat.IsHeldByMe) 
            return $"Ghế {seat.SeatDisplayName} - Bạn đang giữ chỗ (hoàn tất trong 10 phút)";
        if (seat.IsHeldByOther) 
            return $"Ghế {seat.SeatDisplayName} - Khách khác đang giữ tạm thời (còn < 10 phút)";

        return $"Ghế {seat.SeatDisplayName} ({seat.SeatType}) - Giá: {seat.FinalPrice:N0} đ";
    }

    public void Dispose()
    {
        HoldingStore.OnSeatsChanged -= HandleExternalSeatsChanged;
        StopTimer();
    }
}
