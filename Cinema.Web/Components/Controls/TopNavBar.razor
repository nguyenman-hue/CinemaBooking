﻿﻿@using Cinema.UseCases.PluginInterfaces.StateStore
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider
@inject UserSessionService UserSession
@inject ISeatHoldingStateStore HoldingStore
@inject IJSRuntime JSRuntime

<header class="cinema-navbar">
    <div class="container-fluid px-lg-4 d-flex align-items-center justify-content-between flex-wrap flex-lg-nowrap gap-3">
        <!-- Logo -->
        <a href="/" class="cinema-brand" @onclick="CloseNavMenu">
            <i class="bi bi-film"></i>
            <span>Starlight <span class="brand-badge">Huế</span></span>
        </a>

        <!-- Mobile Toggler Button (☰) -->
        <button class="btn btn-outline-warning btn-sm d-lg-none px-2 py-1 border-0" type="button" @onclick="ToggleNavMenu" aria-label="Toggle navigation">
            <i class="bi @(_isMenuCollapsed ? "bi-list" : "bi-x-lg") fs-2 text-warning"></i>
        </button>

        <!-- Collapsible Navigation (Inline single row on Desktop, Expandable Drawer on Mobile) -->
        <div class="cinema-nav-collapse @(_isMenuCollapsed ? "d-none d-lg-flex" : "d-flex") flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-lg-between flex-grow-1 gap-3">
            <!-- Main Nav Links -->
            <nav class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">
                <NavLink href="" Match="NavLinkMatch.All" class="cinema-nav-link" @onclick="CloseNavMenu">
                    <i class="bi bi-house-door me-1"></i>Trang Chủ
                </NavLink>
                <NavLink href="lookup" class="cinema-nav-link" @onclick="CloseNavMenu">
                    <i class="bi bi-search me-1"></i>Tra Cứu Vé
                </NavLink>

                <!-- Customer Links -->
                <AuthorizeView Roles="Customer">
                    <Authorized>
                        <NavLink href="my-bookings" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-ticket-perforated me-1"></i>Vé Của Tôi
                        </NavLink>
                    </Authorized>
                </AuthorizeView>

                <!-- Admin Links -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <NavLink href="admin" Match="NavLinkMatch.All" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-grid-1x2-fill me-1"></i>Tổng Quan
                        </NavLink>
                        <NavLink href="admin/movies" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-film me-1"></i>Quản Lý Phim
                        </NavLink>
                        <NavLink href="admin/showtimes" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-calendar3 me-1"></i>Lịch Chiếu
                        </NavLink>
                        <NavLink href="admin/reports" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-graph-up-arrow me-1"></i>Báo Cáo Tỷ Lệ Lấp Đầy
                        </NavLink>
                        <NavLink href="admin/bookings" class="cinema-nav-link" @onclick="CloseNavMenu">
                            <i class="bi bi-receipt me-1"></i>Đơn Đặt Vé
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <!-- Right Side: Auth Controls -->
            <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
                            @if (context.User.IsInRole("Admin"))
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                    <i class="bi bi-shield-check me-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                    <i class="bi bi-person-fill me-1"></i>@context.User.Identity?.Name (Thành viên)
                                </span>
                            }

                            <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center">
                            <a href="/login" class="btn btn-cinema-gold btn-sm px-3 fw-bold w-100 text-center" style="border-radius: 8px;" @onclick="CloseNavMenu">
                                <i class="bi bi-person-circle me-1"></i>Đăng Nhập / Đăng Ký
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</header>

@code {
    private bool _isMenuCollapsed = true;

    private void ToggleNavMenu()
    {
        _isMenuCollapsed = !_isMenuCollapsed;
    }

    private void CloseNavMenu()
    {
        _isMenuCollapsed = true;
    }

    private async Task HandleLogout()
    {
        _isMenuCollapsed = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(UserSession.SessionId))
            {
                HoldingStore.ReleaseAllBySession(UserSession.SessionId);
            }
            try
            {
                var clientSessionId = await JSRuntime.InvokeAsync<string>("getCinemaSessionId");
                if (!string.IsNullOrWhiteSpace(clientSessionId))
                {
                    HoldingStore.ReleaseAllBySession(clientSessionId);
                }
            }
            catch { }
            await JSRuntime.InvokeVoidAsync("clearCinemaSession");
        }
        catch { }
        // 1. Đăng xuất bình thường
        await AuthStateProvider.LogoutAsync();
        // 2. Về Trang Chủ
        Navigation.NavigateTo("/");
    }
}
