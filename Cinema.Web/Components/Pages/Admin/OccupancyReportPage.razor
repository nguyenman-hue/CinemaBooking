@page "/admin/reports"
@attribute [Authorize(Roles = "Admin")]
@inject IViewOccupancyReportUseCase ViewOccupancyReportUseCase

<PageTitle>Báo Cáo Tỷ Lệ Lấp Đầy - Admin Starlight</PageTitle>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h2 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-pie-chart-fill text-warning"></i>
                <span>Báo Cáo Tỷ Lệ Lấp Đầy &amp; Doanh Thu</span>
            </h2>
            <p class="text-muted mb-0">Thống kê hiệu suất bán vé, tỷ lệ lấp đầy ghế theo từng suất chiếu và doanh thu thực tế.</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadReportAsync">
            <i class="bi bi-arrow-clockwise me-1"></i>Làm mới báo cáo
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Đang tổng hợp dữ liệu báo cáo từ CSDL...</p>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card card-clean p-3 shadow-sm" style="border-left: 4px solid #f59e0b !important;">
                    <small class="fw-bold" style="color: #94a3b8;">TỔNG DOANH THU</small>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@_totalRevenue.ToString("N0") đ</h3>
                    <small class="text-success"><i class="bi bi-graph-up-arrow me-1"></i>Từ các vé đã bán</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-clean p-3 shadow-sm" style="border-left: 4px solid #22c55e !important;">
                    <small class="fw-bold" style="color: #94a3b8;">TỔNG VÉ ĐÃ BÁN</small>
                    <h3 class="fw-bold text-success mb-0 mt-1">@_totalBookedSeats vé</h3>
                    <small style="color: #94a3b8;">Toàn bộ suất chiếu</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-clean p-3 shadow-sm" style="border-left: 4px solid #38bdf8 !important;">
                    <small class="fw-bold" style="color: #94a3b8;">LẤP ĐẦY BÌNH QUÂN</small>
                    <h3 class="fw-bold text-info mb-0 mt-1">@_avgOccupancyRate.ToString("F1")%</h3>
                    <small style="color: #94a3b8;">Tỷ lệ lấp ghế trung bình</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card card-clean p-3 shadow-sm" style="border-left: 4px solid #a855f7 !important;">
                    <small class="fw-bold" style="color: #94a3b8;">TỔNG SUẤT CHIẾU</small>
                    <h3 class="fw-bold mb-0 mt-1" style="color: #c084fc;">@_reports.Count suất</h3>
                    <small style="color: #94a3b8;">Đang theo dõi trong rạp</small>
                </div>
            </div>
        </div>

        <!-- Occupancy Report Table -->
        <div class="card card-clean p-4 shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 border-bottom mb-3" style="border-color: rgba(255,255,255,0.08) !important;">
                <h5 class="fw-bold text-white mb-0">
                    <i class="bi bi-table text-warning me-2"></i>Chi Tiết Tỷ Lệ Lấp Đầy Theo Suất Chiếu
                </h5>
                <div class="d-flex align-items-center gap-2 small text-muted flex-wrap">
                    <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-pill" style="width: 8px; height: 8px; padding: 0; background: #10b981;"></span> &ge;75% Cháy vé</span>
                    <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-pill" style="width: 8px; height: 8px; padding: 0; background: #f97316;"></span> &ge;50% Đông khách</span>
                    <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-pill" style="width: 8px; height: 8px; padding: 0; background: #f59e0b;"></span> &ge;20% Bán chạy</span>
                    <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-pill" style="width: 8px; height: 8px; padding: 0; background: #38bdf8;"></span> &ge;10% Đang bán</span>
                    <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-pill" style="width: 8px; height: 8px; padding: 0; background: #818cf8;"></span> &gt;0% Mới mở bán</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Suất #</th>
                            <th>Tên Phim</th>
                            <th style="width: 170px;">Phòng Chiếu</th>
                            <th style="width: 160px;">Thời Gian Chiếu</th>
                            <th class="text-center" style="width: 140px;">Số Ghế Bán / Tổng</th>
                            <th style="min-width: 220px;">Tỷ Lệ Lấp Đầy</th>
                            <th class="text-end" style="width: 130px;">Doanh Thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _reports)
                        {
                            <tr>
                                <td class="font-monospace text-muted">#@r.ShowtimeId</td>
                                <td>
                                    <strong class="text-white fs-6">@r.MovieTitle</strong>
                                </td>
                                <td><span class="badge badge-cinema-screen">@r.AuditoriumName</span></td>
                                <td style="color: #cbd5e1;">@r.StartTime.ToString("HH:mm - dd/MM/yyyy")</td>
                                <td class="text-center">
                                    @if (r.BookedSeats > 0)
                                    {
                                        <span class="fw-bold" style="color: @GetRateTextColor(r.OccupancyRate);">@r.BookedSeats</span>
                                        <span style="color: #64748b;"> / @r.TotalSeats</span>
                                    }
                                    else
                                    {
                                        <span style="color: #64748b;">0 / @r.TotalSeats</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge" style="@GetBadgeStyle(r.OccupancyRate)">
                                            @GetStatusText(r.OccupancyRate)
                                        </span>
                                        <span class="fw-bold font-monospace" style="color: @GetRateTextColor(r.OccupancyRate); font-size: 0.85rem;">
                                            @r.OccupancyRate.ToString("F1")%
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden;">
                                        <div class="progress-bar" role="progressbar" 
                                             style="width: @(r.OccupancyRate)%; min-width: @(r.OccupancyRate > 0 ? "6px" : "0"); background: @GetProgressBarGradient(r.OccupancyRate); box-shadow: @GetProgressBarShadow(r.OccupancyRate); border-radius: 999px; transition: width 0.6s ease;" 
                                             aria-valuenow="@r.OccupancyRate" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end fw-bold fs-6" style="color: @(r.TotalRevenue > 0 ? "#f59e0b" : "#64748b");">
                                    @r.TotalRevenue.ToString("N0") đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<OccupancyReportDto> _reports = new();
    private bool _isLoading = true;
    private decimal _totalRevenue = 0;
    private int _totalBookedSeats = 0;
    private decimal _avgOccupancyRate = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        try
        {
            var res = await ViewOccupancyReportUseCase.ExecuteAsync();
            _reports = res.ToList();

            _totalRevenue = _reports.Sum(r => r.TotalRevenue);
            _totalBookedSeats = _reports.Sum(r => r.BookedSeats);
            int totalSeatsAll = _reports.Sum(r => r.TotalSeats);
            _avgOccupancyRate = totalSeatsAll > 0 ? (decimal)_totalBookedSeats / totalSeatsAll * 100 : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetProgressBarGradient(decimal rate) => rate switch
    {
        >= 75 => "linear-gradient(90deg, #059669, #10b981)",
        >= 50 => "linear-gradient(90deg, #ea580c, #f97316)",
        >= 20 => "linear-gradient(90deg, #d97706, #f59e0b)",
        >= 10 => "linear-gradient(90deg, #0284c7, #38bdf8)",
        > 0   => "linear-gradient(90deg, #6366f1, #818cf8)",
        _     => "transparent"
    };

    private string GetProgressBarShadow(decimal rate) => rate switch
    {
        >= 75 => "0 0 10px rgba(16, 185, 129, 0.5)",
        >= 50 => "0 0 10px rgba(249, 115, 22, 0.5)",
        >= 20 => "0 0 8px rgba(245, 158, 11, 0.5)",
        >= 10 => "0 0 8px rgba(56, 189, 248, 0.4)",
        > 0   => "0 0 6px rgba(129, 140, 248, 0.4)",
        _     => "none"
    };

    private string GetRateTextColor(decimal rate) => rate switch
    {
        >= 75 => "#34d399",
        >= 50 => "#fb923c",
        >= 20 => "#fbbf24",
        >= 10 => "#38bdf8",
        > 0   => "#a5b4fc",
        _     => "#64748b"
    };

    private string GetStatusText(decimal rate) => rate switch
    {
        >= 85 => "Cháy vé 🔥",
        >= 60 => "Gần kín chỗ",
        >= 30 => "Đông khách",
        >= 10 => "Đang bán tốt",
        > 0   => "Mới mở bán",
        _     => "Chưa có vé"
    };

    private string GetBadgeStyle(decimal rate) => rate switch
    {
        >= 85 => "background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); font-size: 0.72rem; font-weight: 600; padding: 2px 7px; border-radius: 6px;",
        >= 60 => "background: rgba(249, 115, 22, 0.15); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.35); font-size: 0.72rem; font-weight: 600; padding: 2px 7px; border-radius: 6px;",
        >= 30 => "background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); font-size: 0.72rem; font-weight: 600; padding: 2px 7px; border-radius: 6px;",
        >= 10 => "background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.35); font-size: 0.72rem; font-weight: 600; padding: 2px 7px; border-radius: 6px;",
        > 0   => "background: rgba(99, 102, 241, 0.15); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.35); font-size: 0.72rem; font-weight: 500; padding: 2px 7px; border-radius: 6px;",
        _     => "background: rgba(255, 255, 255, 0.04); color: #64748b; border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.72rem; font-weight: 400; padding: 2px 7px; border-radius: 6px;"
    };
}