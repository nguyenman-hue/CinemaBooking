@page "/"
@inject IViewMoviesUseCase ViewMoviesUseCase
@inject IViewShowtimesUseCase ViewShowtimesUseCase
@inject NavigationManager Navigation

<PageTitle>Starlight Cinema Huế - Phim Đang Chiếu &amp; Lịch Chiếu</PageTitle>

<!-- Hero Section Dark Cinema -->
<section class="py-4 py-md-5 mb-4 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 80% 20%, #1e1b4b 0%, #0b0f19 75%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" 
                     style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.5px;">
                    <i class="bi bi-stars"></i> RẠP PHIM ĐẲNG CẤP QUỐC TẾ TẠI HUẾ
                </div>
                <h1 class="display-5 fw-extrabold text-white mb-3" style="font-weight: 800; letter-spacing: -1px;">
                    Chọn Ghế Nhanh Chóng &amp; <br /><span style="color: #f59e0b;">Trải Nghiệm Điện Ảnh</span> Đỉnh Cao
                </h1>
                <p class="lead mb-4" style="color: #94a3b8; font-size: 1.15rem; max-width: 650px;">
                    Thưởng thức bom tấn điện ảnh với chuẩn âm thanh <strong>Dolby Atmos</strong> và màn chiếu cực đại <strong>IMAX Laser</strong>. Chọn vị trí ngồi yêu thích chỉ trong vài thao tác trực quan!
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#movies-section" class="btn btn-cinema-gold btn-lg px-4 py-3 d-flex align-items-center gap-2">
                        <i class="bi bi-ticket-perforated-fill fs-5"></i>
                        <span>Xem Phim &amp; Đặt Vé Ngay</span>
                    </a>
                    <a href="/lookup" class="btn btn-outline-light btn-lg px-4 py-3 d-flex align-items-center gap-2" 
                       style="border-radius: 10px; font-weight: 700; border-color: rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05);">
                        <i class="bi bi-search"></i>
                        <span>Tra Cứu Vé Đã Đặt</span>
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div class="card p-3 shadow-lg border-0" 
                     style="background: rgba(17, 24, 39, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 22px; transform: rotate(2deg);">
                    <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600&auto=format&fit=crop&q=80" 
                         alt="Cinema banner" class="img-fluid rounded-3" style="height: 240px; object-fit: cover;">
                    <div class="mt-3 text-start">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-danger px-2 py-1 fw-bold">ĐANG CHIẾU</span>
                            <span class="text-warning fw-bold"><i class="bi bi-star-fill me-1"></i>9.8 / 10</span>
                        </div>
                        <h6 class="fw-bold text-white mt-2 mb-0">Starlight Cinema Huế - Dolby Atmos</h6>
                        <small class="text-secondary" style="color: #94a3b8 !important;">Phòng chiếu tiêu chuẩn quốc tế</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- AI Assistant Section -->
<!-- Main Movies List -->
<div class="container my-5" id="movies-section">
    <!-- Header with Date Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3" 
         style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <div>
            <h2 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-camera-reels-fill text-warning"></i>
                <span>Phim Đang Chiếu</span>
            </h2>
            <p class="mb-0" style="color: #94a3b8;">Chọn suất chiếu phù hợp để xem sơ đồ phòng và chọn ghế ngồi yêu thích.</p>
        </div>

        <div class="btn-group p-1 rounded-pill" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.1);">
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 0 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(0)">
                Hôm Nay (@VietnamTime.Today.ToString("dd/MM"))
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 1 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(1)">
                Ngày Mai (@VietnamTime.Today.AddDays(1).ToString("dd/MM"))
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 2 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(2)">
                Tất Cả Suất Chiếu
            </button>
        </div>
    </div>

    <!-- Modern Cinema Search Bar & Quick Genre Filters (Full width, sleek glassmorphism) -->
    <div class="card p-3 p-md-4 mb-4 border-0 shadow-lg" 
         style="background: linear-gradient(135deg, rgba(17, 24, 39, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%); border: 1px solid rgba(255, 255, 255, 0.08) !important; border-radius: 18px; backdrop-filter: blur(12px);">
        <div class="row g-3 align-items-center">
            <!-- Search Input with icon -->
            <div class="col-12 col-lg-6">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-warning fs-5"></i>
                    <input type="text"
                           class="form-control form-control-lg text-white border-0 ps-5 pe-5 rounded-pill shadow-sm"
                           placeholder="Tìm tên phim, diễn viên, đạo diễn..."
                           value="@_searchKeyword"
                           @oninput="HandleSearchInput"
                           style="background: rgba(30, 41, 59, 0.7) !important; border: 1px solid rgba(255, 255, 255, 0.12) !important; font-size: 0.95rem;" />
                    @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                    {
                        <button class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-2 text-white-50 text-decoration-none p-0"
                                @onclick="ClearSearch" title="Xóa từ khóa tìm kiếm">
                            <i class="bi bi-x-circle-fill fs-5 text-secondary"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Quick Genre Filters -->
            <div class="col-12 col-lg-6">
                <div class="d-flex align-items-center gap-1 flex-wrap justify-content-lg-end">
                    <span class="small fw-bold text-secondary me-2"><i class="bi bi-funnel-fill text-warning me-1"></i>Thể loại:</span>
                    @foreach (var genre in _genreCategories)
                    {
                        <button type="button"
                                class="btn btn-sm rounded-pill px-3 py-1 fw-semibold @(_selectedGenre == genre ? "btn-warning text-dark shadow-sm" : "btn-outline-secondary text-light")"
                                style="font-size: 0.82rem; border-color: rgba(255, 255, 255, 0.15);"
                                @onclick="() => FilterByGenre(genre)">
                            @genre
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Đang tải danh sách phim...</span>
            </div>
            <p class="mt-2" style="color: #94a3b8;">Đang tải lịch chiếu phim từ hệ thống...</p>
        </div>
    }
    else if (!_movies.Any())
    {
        <div class="alert alert-dark text-center py-4 border-secondary text-white">
            <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>Hiện tại chưa có suất chiếu nào trong khoảng thời gian này.
        </div>
    }
    else if (!FilteredMovies.Any())
    {
        <div class="card p-5 text-center my-4 border-0 shadow-lg" 
             style="background: rgba(17, 24, 39, 0.7); border: 1px dashed rgba(245, 158, 11, 0.3) !important; border-radius: 20px;">
            <div class="mb-3">
                <i class="bi bi-film text-warning" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-white fw-bold">Không tìm thấy phim phù hợp</h4>
            <p class="text-secondary mx-auto mb-3" style="max-width: 500px; color: #94a3b8 !important;">
                Không có bộ phim nào khớp với từ khóa "<strong>@_searchKeyword</strong>" hoặc thể loại "<strong>@_selectedGenre</strong>".
            </p>
            <div>
                <button class="btn btn-cinema-gold px-4 py-2 fw-bold" @onclick="ClearAllFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc &amp; Xem tất cả phim
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in FilteredMovies)
            {
                var movieShowtimes = _showtimes.Where(s => s.MovieId == movie.MovieId).OrderBy(s => s.StartTime).ToList();

                <div class="col-12 col-md-6 col-lg-6">
                    <div class="card movie-card h-100">
                        <div class="row g-0 h-100">
                            <!-- Left: Poster -->
                            <div class="col-5 col-sm-4 position-relative">
                                <div class="movie-poster-wrap h-100">
                                    <img src="@movie.PosterUrl" alt="@movie.Title" class="movie-poster-img" />
                                    <span class="age-badge @GetAgeBadgeClass(movie.AgeRating)">
                                        @movie.AgeRating
                                    </span>
                                </div>
                            </div>

                            <!-- Right: Movie Details & Showtimes -->
                            <div class="col-7 col-sm-8 p-3 p-sm-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h4 class="fw-bold text-white mb-1" style="font-size: 1.25rem;">@movie.Title</h4>
                                    <div class="d-flex flex-wrap gap-2 small mb-2" style="color: #94a3b8;">
                                        <span><i class="bi bi-clock me-1 text-warning"></i>@movie.DurationMinutes phút</span>
                                        <span>•</span>
                                        <span>@movie.Genre</span>
                                    </div>
                                    <p class="small mb-3 text-secondary text-truncate-3" style="color: #cbd5e1 !important; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @movie.Description
                                    </p>
                                    <div class="small mb-2" style="color: #94a3b8;">
                                        <strong>Đạo diễn:</strong> @movie.Director<br />
                                        <strong>Diễn viên:</strong> @movie.Cast
                                    </div>
                                </div>

                                <!-- Showtimes Section -->
                                <div class="mt-3 pt-2" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small fw-bold text-warning text-uppercase" style="letter-spacing: 0.5px;">
                                            <i class="bi bi-calendar2-week me-1"></i>Suất Chiếu
                                        </span>
                                        <small style="color: #64748b;">Chọn suất để xem ghế</small>
                                    </div>

                                    @if (!movieShowtimes.Any())
                                    {
                                        <div class="small fst-italic py-1" style="color: #64748b;">
                                            Chưa có suất chiếu trong ngày đã chọn.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var st in movieShowtimes)
                                            {
                                                if (st.StartTime <= VietnamTime.Now)
                                                {
                                                    <div class="showtime-pill is-past" title="@($"Suất chiếu đã bắt đầu lúc {st.StartTime:HH:mm} (Không thể đặt vé)")">
                                                        <span class="text-decoration-line-through">@st.StartTime.ToString("HH:mm")</span>
                                                        <span class="screen-tag text-muted"><i class="bi bi-clock-history me-1"></i>Đã chiếu</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a href="/booking/@st.ShowtimeId" class="showtime-pill" title="@($"Đặt vé suất {st.StartTime:HH:mm} ({st.ScreenType})")">
                                                        <span>@st.StartTime.ToString("HH:mm")</span>
                                                        <span class="screen-tag">@st.ScreenType</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Featured Movies Grid using Reusable MovieCardComponent (K3.1 Rubric) -->
    <div class="mt-5 pt-4" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h3 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-fire text-danger"></i>
                    <span>Tuyển Tập Phim Hot &amp; Đề Xuất</span>
                </h3>
                <p class="text-muted small mb-0">Những bộ phim bom tấn đỉnh cao đang làm mưa làm gió tại phòng vé</p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var movie in FilteredMovies.Take(4))
            {
                <div class="col-6 col-md-3">
                    <MovieCardComponent Movie="@movie" OnSelectMovie="HandleCardSelectMovie" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _searchKeyword = "";
    private string _selectedGenre = "T\u1EA5t C\u1EA3";
    private readonly string[] _genreCategories = new[] { "T\u1EA5t C\u1EA3", "H\u00E0nh \u0110\u1ED9ng", "Ho\u1EA1t H\u00ECnh", "H\u00E0i", "Kinh D\u1ECB", "Khoa H\u1ECDc Vi\u1EC5n T\u01B0\u1EDFng", "T\u00E2m L\u00FD" };

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchKeyword = e.Value?.ToString() ?? "";
    }

    private void ClearSearch()
    {
        _searchKeyword = "";
    }

    private void FilterByGenre(string genre)
    {
        _selectedGenre = genre;
    }

    private void ClearAllFilters()
    {
        _searchKeyword = "";
        _selectedGenre = "T\u1EA5t C\u1EA3";
    }

    private IEnumerable<Movie> FilteredMovies
    {
        get
        {
            var list = _movies.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchKeyword))
            {
                var q = _searchKeyword.Trim().ToLower();
                list = list.Where(m =>
                    (!string.IsNullOrEmpty(m.Title) && m.Title.ToLower().Contains(q)) ||
                    (!string.IsNullOrEmpty(m.Genre) && m.Genre.ToLower().Contains(q)) ||
                    (!string.IsNullOrEmpty(m.Director) && m.Director.ToLower().Contains(q)) ||
                    (!string.IsNullOrEmpty(m.Cast) && m.Cast.ToLower().Contains(q)));
            }

            if (!string.IsNullOrWhiteSpace(_selectedGenre) && _selectedGenre != "T\u1EA5t C\u1EA3")
            {
                list = list.Where(m => !string.IsNullOrEmpty(m.Genre) && m.Genre.Contains(_selectedGenre, StringComparison.OrdinalIgnoreCase));
            }

            return list;
        }
    }

    private void HandleCardSelectMovie(Movie movie)
    {
        var firstShowtime = _showtimes.FirstOrDefault(s => s.MovieId == movie.MovieId && s.StartTime > VietnamTime.Now);
        if (firstShowtime != null)
        {
            Navigation.NavigateTo($"/booking/{firstShowtime.ShowtimeId}");
        }
        else
        {
            Navigation.NavigateTo("/#movies-section");
        }
    }
    private List<Movie> _movies = new();
    private List<Showtime> _showtimes = new();
    private bool _isLoading = true;
    private int _selectedDateFilter = 0; // 0 = Hôm nay, 1 = Ngày mai, 2 = Tất cả

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task FilterByDate(int filterOption)
    {
        _selectedDateFilter = filterOption;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var movies = (await ViewMoviesUseCase.ExecuteAsync(activeOnly: true)).ToList();
            _movies = movies;

            if (_selectedDateFilter == 2)
            {
                _showtimes = (await ViewShowtimesUseCase.ExecuteAllAsync()).ToList();
            }
            else
            {
                var targetDate = _selectedDateFilter == 0 ? VietnamTime.Today : VietnamTime.Today.AddDays(1);
                _showtimes = (await ViewShowtimesUseCase.ExecuteByDateAsync(targetDate)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading movies: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetAgeBadgeClass(string? rating) => rating?.ToUpper() switch
    {
        "T18" => "age-badge-t18",
        "T16" => "age-badge-t16",
        "T13" => "age-badge-t13",
        "K"   => "age-badge-k",
        "P"   => "age-badge-p",
        _     => "bg-secondary"
    };
}

