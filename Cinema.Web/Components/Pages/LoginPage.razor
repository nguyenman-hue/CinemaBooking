@page "/login"
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Đăng Nhập Tài Khoản - Starlight Cinema Huế</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-clean p-4 p-md-5 shadow-sm">
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="text-warning fs-1 mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold text-white">Đăng Nhập</h3>
                    <p class="text-muted small">
                        Dành cho Thành Viên rạp chiếu và Quản Trị Viên hệ thống
                    </p>
                </div>

                @* Cảnh báo nổi bật khi bị chặn từ khu vực Admin *@
                @if (IsAdminRedirect)
                {
                    <div class="alert border border-warning border-opacity-50 text-light py-3 px-3 mb-4 rounded-3 d-flex align-items-start gap-3 shadow" style="background: rgba(245, 158, 11, 0.12); border-left: 4px solid #f59e0b !important;">
                        <i class="bi bi-shield-exclamation text-warning fs-3 flex-shrink-0 mt-1"></i>
                        <div>
                            <div class="fw-bold text-warning mb-1" style="font-size: 1rem;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Khu Vực Quản Trị Viên (Admin)
                            </div>
                            <div class="small text-white-50 leading-relaxed">
                                Bạn vừa cố gắng truy cập trang Quản trị hệ thống. Khu vực này được bảo vệ, vui lòng đăng nhập bằng <strong>tài khoản Quản Trị Viên</strong> để tiếp tục!
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger small py-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@_errorMessage
                    </div>
                }

                <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light">Tên Đăng Nhập hoặc Email *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" @bind="_username" placeholder="admin hoặc khachhang..." required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-light">Mật Khẩu *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                            <input type="password" class="form-control" @bind="_password" placeholder="••••••••" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-cinema-gold w-100 py-2 fw-bold" disabled="@_isSubmitting" style="border-radius: 8px;">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang kiểm tra...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            <span>Đăng Nhập</span>
                        }
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-muted small">Chưa có tài khoản thành viên?</span>
                    <a href="/register" class="text-warning text-decoration-none fw-bold small ms-1">Đăng ký ngay tại đây</a>
                </div>

                <!-- Quick Autofill Box for Grading Demo (2 Roles: Admin & Customer) -->
                <div class="p-3 rounded-3 border mt-4" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1) !important;">
                    <div class="small fw-bold text-muted mb-2">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Tài khoản chấm bài mẫu (2 Vai trò theo Rubric):
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <button class="btn btn-sm btn-outline-warning text-start py-2" @onclick="AutoFillCustomer">
                            <div class="fw-bold"><i class="bi bi-person-check me-1"></i>1. Khách Hàng (Customer):</div>
                            <small class="text-white-50">User: <code>khachhang</code> | Pass: <code>khach123</code></small>
                        </button>
                        <button class="btn btn-sm btn-outline-info text-start py-2" @onclick="AutoFillAdmin">
                            <div class="fw-bold"><i class="bi bi-shield-lock me-1"></i>2. Quản Trị Viên (Admin):</div>
                            <small class="text-white-50">User: <code>admin</code> | Pass: <code>admin123</code></small>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string _username = "";
    private string _password = "";
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private bool IsAdminRedirect
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ReturnUrl)) return false;
            var decoded = System.Net.WebUtility.UrlDecode(ReturnUrl);
            return decoded.Contains("/admin", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string DisplayReturnUrl
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ReturnUrl)) return "/admin";
            return System.Net.WebUtility.UrlDecode(ReturnUrl);
        }
    }

    private void AutoFillAdmin()
    {
        _username = "admin";
        _password = "admin123";
        _errorMessage = null;
    }

    private void AutoFillCustomer()
    {
        _username = "khachhang";
        _password = "khach123";
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var user = await AuthStateProvider.LoginAsync(_username, _password);
            if (user != null)
            {
                if (user.Role == "Admin")
                {
                    if (!string.IsNullOrWhiteSpace(ReturnUrl))
                    {
                        var decoded = System.Net.WebUtility.UrlDecode(ReturnUrl);
                        if (decoded.StartsWith("/"))
                        {
                            Navigation.NavigateTo(decoded);
                            return;
                        }
                    }
                    Navigation.NavigateTo("/admin/showtimes");
                }
                else
                {
                    // Tài khoản khách hàng nếu có ReturnUrl không phải admin thì đi tiếp
                    if (!string.IsNullOrWhiteSpace(ReturnUrl) && !IsAdminRedirect)
                    {
                        var decoded = System.Net.WebUtility.UrlDecode(ReturnUrl);
                        if (decoded.StartsWith("/"))
                        {
                            Navigation.NavigateTo(decoded);
                            return;
                        }
                    }
                    Navigation.NavigateTo("/my-bookings");
                }
            }
            else
            {
                _errorMessage = "Tên đăng nhập / Email hoặc mật khẩu không chính xác.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi đăng nhập: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
