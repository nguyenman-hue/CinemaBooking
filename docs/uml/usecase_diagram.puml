@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12

actor "Khách Hàng\n(Customer)" as Customer #DarkOrange
actor "Quản Trị Viên\n(Admin)" as Admin #SteelBlue

rectangle "HỆ THỐNG ĐẶT VÉ RẠP PHIM - STARLIGHT CINEMA HUẾ" {
    package "Phân Hệ Khách Hàng" {
        usecase "UC01: Xem Phim & Lịch Chiếu" as UC01
        usecase "UC02: Tìm Kiếm Phim AI (Gemini)" as UC02
        usecase "UC03: Chọn Ghế Real-time (Giữ 10p)" as UC03
        usecase "UC04: Đặt Vé & VietQR 24/7" as UC04
        usecase "UC05: Tra Cứu Vé Điện Tử (QR)" as UC05
        usecase "UC06: Đăng Ký / Đăng Nhập" as UC06
        usecase "UC07: Xem Lịch Sử Vé Của Tôi" as UC07
    }

    package "Phân Hệ Quản Trị" {
        usecase "UC08: Quản Lý Phim (CRUD)" as UC08
        usecase "UC09: Xếp Lịch Chiếu (Chống Trùng)" as UC09
        usecase "UC10: Quản Lý Đơn Đặt Vé" as UC10
        usecase "UC11: Báo Cáo Doanh Thu & Lấp Đầy" as UC11
    }
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
Customer --> UC07

Admin --> UC08
Admin --> UC09
Admin --> UC10
Admin --> UC11

UC04 ..> UC03 : <<include>>
@enduml
